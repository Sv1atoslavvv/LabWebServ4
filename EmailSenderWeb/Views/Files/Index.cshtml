@model IReadOnlyList<EmailSenderWeb.Models.StoredFileItem>
@{
    ViewData["Title"] = "Файли";
}

<section class="hero">
    <p class="eyebrow">Лабораторна робота № 4 · ASP.NET Core MVC</p>
    <h1>Файли на сервері</h1>
    <p class="lead">Завантажуйте файли до wwwroot/Files та переглядайте збережені документи й зображення.</p>
</section>

@if (ViewBag.Notice is string notice)
{
    <div class="alert success" role="status">@notice</div>
}
@if (ViewBag.Error is string error)
{
    <div class="alert failure" role="alert">@error</div>
}

<section class="card upload-card">
    <h2>Завантажити файл</h2>
    <p>Максимальний розмір — 20 МБ. Активні файли, які можуть виконувати код у браузері, заблоковано.</p>
    <form asp-controller="Files" asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label for="file">Оберіть файл</label>
        <input id="file" name="file" type="file" required />
        <button type="submit">Завантажити</button>
    </form>
</section>

<section class="files-section">
    <div class="section-heading">
        <div>
            <h2>Збережені файли</h2>
            <p class="lead">Усього: @Model.Count</p>
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card empty-state">Поки що файлів немає. Завантажте перший файл за допомогою форми вище.</div>
    }
    else
    {
        <div class="card table-wrap">
            <table>
                <thead>
                    <tr><th>Назва</th><th>Розмір</th><th>Додано</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var file in Model)
                {
                    <tr>
                        <td class="file-name">@file.DisplayName</td>
                        <td>@(file.Length < 1024 ? $"{file.Length} Б" : $"{file.Length / 1024.0:0.##} КБ")</td>
                        <td>@file.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td><a class="button-link small-button" asp-controller="Files" asp-action="Details" asp-route-name="@file.StoredName">@(file.CanPreview ? "Переглянути" : "Відкрити")</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
